<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <add key="DataRoot" value="Data" />
        <add key="UnderConsumptionAlpha" value="0.85" />
        <add key="OverConsumptionBeta" value="1.15" />
        <add key="SpikeDeltaMW" value="500" />
        <add key="DailyLimitMW" value="100000" />
    </appSettings>
    <system.serviceModel>
        <bindings>
            <netTcpBinding>
                <binding name="streamingTcp"
                         transferMode="Buffered"
                         maxReceivedMessageSize="104857600"
                         maxBufferPoolSize="104857600"
                         sendTimeout="00:10:00"
                         receiveTimeout="00:10:00"
                         openTimeout="00:01:00"
                         closeTimeout="00:01:00">
                    <readerQuotas maxDepth="64"
                                  maxStringContentLength="10485760"
                                  maxArrayLength="10485760"
                                  maxBytesPerRead="10485760"
                                  maxNameTableCharCount="10485760" />
                    <security mode="None" />
                </binding>
            </netTcpBinding>
        </bindings>
        <services>
            <service name="Server.ConsumptionService">
                <host>
                    <baseAddresses>
                        <add baseAddress="net.tcp://localhost:4000/Consumption" />
                    </baseAddresses>
                </host>
                <endpoint address=""
                          binding="netTcpBinding"
                          bindingConfiguration="streamingTcp"
                          contract="Common.IConsumptionService" />
            </service>
        </services>
        <behaviors>
            <serviceBehaviors>
                <behavior>
                    <serviceDebug includeExceptionDetailInFaults="true" />
                </behavior>
            </serviceBehaviors>
        </behaviors>
    </system.serviceModel>
</configuration>
